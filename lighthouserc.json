{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 2,
      "url": [
        "/index.html",
        "/freedoms/index.html",
        "/freedoms/owning-a-home/index.html",
        "/places/index.html",
        "/places/fixture-state/index.html",
        "/records/owning-a-home/fixture-state/index.html",
        "/investigations/index.html",
        "/investigations/000-fixture/index.html",
        "/sources/fixture-statute/index.html",
        "/datasets/ds-fixture/index.html",
        "/questions/index.html",
        "/changelog/index.html",
        "/about/index.html"
      ],
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 400000
          }
        ],
        "unused-javascript": "off",
        "uses-text-compression": "off",
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
