---
// Home: let the visitor do something. One label, one sentence, three actions; the featured Record;
// the freedoms as cards; the five grades in one strip. Explanation lives under About.
import Base from '../layouts/Base.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import { loadAll, nameMap, findingByRef, recordPath, freedomCards, GRADES_IN_ORDER } from '../lib/content';
const all = await loadAll();
const placeNames = nameMap(all.places);
const featured = all.records.find((r) => r.data.status !== 'draft');
const featuredDim = featured ? all.dimensions.find((d) => d.id === featured.data.dimension) : undefined;
const headline = featured ? findingByRef(all.findings, featured.data.headline_finding) : undefined;
const cards = freedomCards(all);
const openCount = all.questions.filter((q) => q.data.status !== 'answered').length;
---
<Base title="Freedom, measured" description="CLOELIA.AI measures how people's practical freedoms changed: for one freedom and one place at a time, what happened, what followed, for whom, what can be measured, how strong the evidence is, and what remains unknown.">
  <section class="hero" aria-labelledby="h-hero">
    <p class="label">Freedom Analytics</p>
    <h1 id="h-hero">How people's practical freedoms changed, measured.</h1>
    <p>Pick a freedom and a place. See what happened, what the numbers show, who it covered, and how strong the evidence is.</p>
    <p class="actions">
      <a class="btn primary" href="/freedoms/">Explore freedoms</a>
      <a class="btn" href="/places/">Explore places</a>
      <a class="btn" href="/questions/">Browse questions{openCount ? ` (${openCount})` : ''}</a>
    </p>
  </section>

  {featured && featuredDim && (
    <section class="section" aria-labelledby="h-featured">
      <p class="label" id="h-featured">Featured Record</p>
      <div class="card featured">
        <div>
          <p class="label">{featuredDim.data.name}</p>
          <h2><a href={recordPath(featured.data.dimension, featured.data.place)}>{placeNames.get(featured.data.place)}</a></h2>
          <dl class="facts">
            <dt>Period</dt><dd>{featured.data.period.from} to {featured.data.period.to}</dd>
            <dt>Covers</dt><dd>{featured.data.covers}</dd>
          </dl>
        </div>
        <div>
          {headline?.item && (
            <>
              <EvidenceBadge grade={headline.item.grade} />
              <p class="take">{headline.item.text}</p>
            </>
          )}
          <p class="actions"><a class="btn primary" href={recordPath(featured.data.dimension, featured.data.place)}>Explore Record</a></p>
          {featured.data.status === 'staging' && <p class="later">Fixture content for the site skeleton; not a real Record.</p>}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="h-freedoms">
    <h2 id="h-freedoms">Freedoms</h2>
    <p class="lead">Each freedom has its own definition and its own measures. There is no combined score.</p>
    <ul class="cards">
      {cards.map((c) => (
        <li class:list={['card', 'tile', { planned: c.records === 0 }]}>
          <h3>{c.name}</h3>
          <p>{c.definition}</p>
          <div class="foot">
            <span class="chip">{c.records ? `${c.records} Record${c.records === 1 ? '' : 's'}` : 'Planned'}</span>
            <a class="go" href={`/freedoms/${c.id}/`}>{c.records ? 'Open' : 'See definition'}</a>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="h-read">
    <h2 id="h-read">How to read the evidence</h2>
    <p class="lead">Every finding carries one of five grades before its text.</p>
    <ul class="grades">
      {GRADES_IN_ORDER.map((g) => <li><EvidenceBadge grade={g} meaning /></li>)}
    </ul>
    <p class="actions"><a class="btn" href="/about/">How CLOELIA works</a></p>
  </section>
</Base>
