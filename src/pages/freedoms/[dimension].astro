---
import Base from '../../layouts/Base.astro';
import EvidenceBadge from '../../components/EvidenceBadge.astro';
import { loadAll, nameMap, recordPath, findingByRef, STATUS_LABEL } from '../../lib/content';
export async function getStaticPaths() {
  const { dimensions } = await loadAll();
  return dimensions.map((d) => ({ params: { dimension: d.id }, props: { dim: d } }));
}
const { dim } = Astro.props;
const all = await loadAll();
const placeNames = nameMap(all.places);
const records = all.records.filter((r) => r.data.dimension === dim.id && r.data.status !== 'draft');
const questions = all.questions.filter((q) => q.data.record.dimension === dim.id && q.data.status !== 'answered');
---
<Base title={dim.data.name} description={dim.data.definition} current="freedoms">
  <p class="crumbs"><a href="/freedoms/">Freedoms</a> / {dim.data.name}</p>
  <p class="label">Freedom</p>
  <h1>{dim.data.name}</h1>
  <p class="lede">{dim.data.definition}</p>
  {records.length === 0 && <p class="actions"><a class="btn" href="/questions/">Browse open questions</a><a class="btn" href="/freedoms/">All freedoms</a></p>}

  <section class="section" aria-labelledby="h-records">
    <h2 id="h-records">Records</h2>
    {records.length ? (
      <ul class="cards">{records.map((r) => { const h = findingByRef(all.findings, r.data.headline_finding); return (
        <li class="card tile">
          <h3><a href={recordPath(r.data.dimension, r.data.place)}>{placeNames.get(r.data.place)}</a></h3>
          <p>{r.data.period.from} to {r.data.period.to}; covers {r.data.covers}</p>
          {h.item && <EvidenceBadge grade={h.item.grade} />}
          <div class="foot"><span class="chip">{r.data.measures.length} measure{r.data.measures.length === 1 ? '' : 's'}</span><a class="go" href={recordPath(r.data.dimension, r.data.place)}>Explore Record</a></div>
        </li>); })}</ul>
    ) : <p class="muted">No Records yet for this freedom. It is defined and planned; the first investigation has not run.</p>}
  </section>

  <section class="section" aria-labelledby="h-scope">
    <h2 id="h-scope">What counts</h2>
    <dl class="facts">
      <dt>Counts</dt><dd>{dim.data.definition}</dd>
      {dim.data.not_covered.length > 0 && <><dt>Not covered</dt><dd>{dim.data.not_covered.join('; ')}</dd></>}
    </dl>
    <details class="more">
      <summary>Measures that could stand for it</summary>
      <div class="body"><ul class="plain">{dim.data.candidate_measures.map((m) => <li>{m.name} <span class="muted">({m.source})</span></li>)}</ul></div>
    </details>
  </section>

  <section class="section" aria-labelledby="h-questions">
    <h2 id="h-questions">Open questions</h2>
    {questions.length ? <ul class="qlist">{questions.map((q) => <li><p class="q">{q.data.text}</p><span class="status"><span class="chip">{STATUS_LABEL[q.data.status]}</span></span></li>)}</ul> : <p class="muted">None recorded for this freedom.</p>}
  </section>
</Base>
