---
import Base from '../../layouts/Base.astro';
import { loadAll, freedomCards } from '../../lib/content';
const all = await loadAll();
const cards = freedomCards(all);
const withRecords = cards.filter((c) => c.records > 0);
const planned = cards.filter((c) => c.records === 0);
---
<Base title="Freedoms" description="The practical freedoms CLOELIA.AI measures, each with its own definition and its own measures. There is no combined score." current="freedoms">
  <h1>Freedoms</h1>
  <p class="lead">A freedom here is a practical ability to act. Each has its own definition and its own measures; there is no combined score.</p>
  <section class="section" aria-labelledby="h-open">
    <h2 id="h-open">With Records</h2>
    {withRecords.length ? (
      <ul class="cards">{withRecords.map((c) => <li class="card tile"><h3>{c.name}</h3><p>{c.definition}</p><div class="foot"><span class="chip">{c.records} Record{c.records === 1 ? '' : 's'}</span><a class="go" href={`/freedoms/${c.id}/`}>Open</a></div></li>)}</ul>
    ) : <p class="muted">No Records published yet.</p>}
  </section>
  <section class="section" aria-labelledby="h-planned">
    <h2 id="h-planned">Planned</h2>
    <p class="lead">Defined and waiting for a first investigation. Each page states what will count and which public measures could stand for it.</p>
    <ul class="cards">{planned.map((c) => <li class="card tile planned"><h3>{c.name}</h3><p>{c.definition}</p><div class="foot"><span class="chip">Planned</span><a class="go" href={`/freedoms/${c.id}/`}>See definition</a></div></li>)}</ul>
  </section>
</Base>
