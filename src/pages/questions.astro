---
import Base from '../layouts/Base.astro';
import { loadAll, recordPath, STATUS_LABEL } from '../lib/content';
const all = await loadAll();
const dimName = (id: string) => all.dimensions.find((d) => d.id === id)?.data.name ?? id;
const placeName = (id: string) => all.places.find((p) => p.id === id)?.data.name ?? id;
const qs = [...all.questions].sort((a, b) => b.data.asked.localeCompare(a.data.asked));
---
<Base title="Open questions" description="The public backlog: every question a Record could not yet answer, with its status." current="questions">
  <h1>Open questions</h1>
  <p class="lead">The public backlog: what a Record could not yet answer. When a question is taken up, its investigation appears here and in the <a href="/feed.xml">feed</a>.</p>
  <ul class="qlist">{qs.map((q) => (
    <li>
      <p class="q">{q.data.text}</p>
      <span class="status"><span class="chip">{STATUS_LABEL[q.data.status]}</span></span>
      <span class="status"><a href={recordPath(q.data.record.dimension, q.data.record.place)}>{dimName(q.data.record.dimension)}, {placeName(q.data.record.place)}</a>{q.data.investigation ? <>; <a href={`/investigations/${q.data.investigation}/`}>investigation {q.data.investigation}</a></> : null}</span>
      {q.data.note ? <span class="status">{q.data.note}</span> : null}
    </li>
  ))}</ul>
</Base>
